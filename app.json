{
  "expo": {
    "name": "Timiza EduAnalytics",
    "slug": "timiza-eduanalytics",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "timiza",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.timizaanalytics.eduanalytics",
      "versionCode": 8,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1565C0"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1565C0"
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64d36646-e731-41ab-aca6-0215c17bdc53"
      }
    },
    "owner": "timishop"
  }
}
